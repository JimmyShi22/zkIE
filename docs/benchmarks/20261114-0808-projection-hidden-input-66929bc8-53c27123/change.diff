+const INDEX_MASK_ORACLE: u64 = 60;
+const INDEX_MASK_TREE: u64 = 202;
+const INDEX_MASK_RUN: Digest = Digest([0x66; 32]);
+const DOT_ORACLE: u64 = 12;
+const DOT_RUN: Digest = Digest([0x67; 32]);
+
+fn index_mask_plan(positions: u32) -> IndexMaskPlan {
+    IndexMaskPlan {
+        oracle: INDEX_MASK_ORACLE,
+        group: GROUP,
+        mask_code: code(),
+        mask_rows: 4,
+        answers: 1,
+        openings: 1,
+        tree: RuntimeTreePlan {
+            tree_number: INDEX_MASK_TREE,
+            leaf_class: 1,
+            log_n: CODE_LOG_N,
+            log_n_zk: CODE_LOG_N,
+            parts: vec![RuntimeTreePart {
+                main_symbols: 0,
+                mask_symbols: 4 * E_DEGREE as u64,
+            }],
+            salt_bytes: SALT,
+            run: INDEX_MASK_RUN,
+            configuration: W_CONFIGURATION,
+        },
+        entries: MaskEntryAllocation::for_variables(
+            MATRIX_ROWS.trailing_zeros() as usize,
+            positions,
+        )
+        .unwrap(),
+    }
+}
+
+fn dot_plan(positions: u32) -> DotMapPlan {
+    DotMapPlan {
+        oracle: DOT_ORACLE,
+        group: GROUP,
+        shape: WShape::new(
+            positions as u64 * HIDDEN as u64,
+            code(),
+            1,
+            positions,
+            SALT,
+            400,
+            2,
+            DOT_RUN,
+            W_CONFIGURATION,
+        )
+        .unwrap(),
+        hidden: HIDDEN as u32,
+    }
+}
+
+fn hidden_plan_for(
+    activation: &CommittedActivation,
+    table: &Table,
+    positions: u32,
+) -> HiddenLinPlan {
+    let mut plan = HiddenLinPlan {
+        norm: None,
+        send: HiddenSendPlan {
+            activation: activation.shape(),
+            activation_configuration: ACTIVATION_CONFIGURATION,
+            activation_root: activation.root(),
+            activation_source: zkie_ops::proof::hidden_send_session::ActivationSource::Commitment,
+            table_shape: table_shape(),
+            table_identity: reader_table_identity(&table.reader).unwrap(),
+            matrix_rows: MATRIX_ROWS,
+            k_lo: K_LO,
+            columns: COLUMNS,
+            group: GROUP,
+            oracle_base: ORACLE_BASE,
+            openings_per_oracle: 2,
+            w: w_shape(positions),
+            index_mask: None,
+            dot: None,
+            expected_dot_root: None,
+            expected_roots: None,
+        },
+        output: HiddenOutputShape {
+            positions,
+            columns: COLUMNS,
+        },
+        masks: vec![Vec::new(); positions as usize],
+        weights: Vec::new(),
+        proximity: HiddenProximityPlan {
+            gu: gu_shape(),
+            omega: omega_shape(),
+            code: code(),
+            mask_code: code(),
+            shared_mask_tree: mask_tree(200),
+            own_mask_tree: mask_tree(201),
+            shared_fresh: 90,
+            own_fresh: 91,
+            column_draws: 2,
+            column_budget: 4,
+            column_work_bits: 0,
+            shared_base_positions: 2,
+            own_base_positions: 2,
+            shared_stages: Vec::new(),
+            own_stages: Vec::new(),
+            planner_checked: false,
+        },
+        output_relation: None,
+        closure: None,
+    };
+    plan.send.index_mask = Some(index_mask_plan(positions));
+    plan.send.dot = Some(dot_plan(positions));
+    plan.proximity.own_mask_tree.mask_rows = 4;
+    plan
+}
