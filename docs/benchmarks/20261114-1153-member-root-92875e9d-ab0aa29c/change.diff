+    entries: &[Fp3],
+) -> Result<RuntimeTree> {
+    let columns = usize::try_from(member.tree.columns()).map_err(|_| Error::ResourceLimit)?;
+    if entries.len() > columns {
+        return Err(Error::ShapeMismatch);
+    }
+    let mut row = vec![Fp3::ZERO; columns];
